# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION (.env)
# Sistem Informasi Klinik & Pelayanan Medis (SIMRS)
# ==============================================================================

# --- AI & GOOGLE GEMINI ---
# GEMINI_API_KEY: API Key resmi Google Gemini untuk fitur AI diagnostik & analisis.
GEMINI_API_KEY=

# --- APLIKASI & SERVER ---
# PORT: Port listen server backend Express (default: 3000)
PORT=3000
# APP_URL: URL publik host aplikasi
APP_URL=
# NODE_ENV: Mode environment ('development' | 'production')
NODE_ENV=development
# DISABLE_HMR: Nonaktifkan Hot Module Replacement pada Vite jika diperlukan
DISABLE_HMR=false

# --- AUTENTIKASI & KEAMANAN ---
# JWT_SECRET: Kunci rahasia enkripsi tanda tangan token JWT login
JWT_SECRET=klinik_puri_medika_fallback_secure_key_2026
# DEBUG_OTP: Set 'true' untuk menampilkan kode OTP di log console / response saat pengujian
DEBUG_OTP=false

# --- KONEKSI DATABASE UTAMA (MySQL VPS / Cloud SQL) ---
# Jika dikosongkan, sistem secara otomatis beralih (fallback) ke Virtual JSON DB.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_DATABASE=

# --- INTEGRASI WHATSAPP GATEWAY (WAHA) ---
# Layanan gateway pengiriman pesan WA, broadcast pasien loyal & follow-up vaksin
WAHA_URL=https://waha.purimedikabdl.com/
WAHA_SESSION=default
WAHA_API_TOKEN=mysecretkeyPuryMedik4123

# --- PENGIRIMAN EMAIL OTP (SMTP) ---
# Konfigurasi server SMTP untuk pengiriman kode OTP / verifikasi email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Klinik Puri Medika" <no-reply@purimedika.com>

# --- INTEGRASI BASEROW DATABASE (OPSIONAL) ---
# Digunakan apabila menghubungkan tabel eksternal via Baserow API
BASEROW_API_TOKEN=
BASEROW_TABLE_URL=
BASEROW_BASE_URL=
